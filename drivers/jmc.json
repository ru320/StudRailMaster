{
  "$schema": "./driver.schema.json",
  "id": "jmc",
  "name": "JMC BLE hub (JG_JMC-…)",
  "runsOn": ["esp32", "pc"],
  "transport": {
    "kind": "gatt",
    "service": "0000fff0-0000-1000-8000-00805f9b34fb",
    "write": "0000fff2-0000-1000-8000-00805f9b34fb",
    "withResponse": true,
    "namePrefix": "JG_JMC",
    "addressType": "public"
  },
  "ports": ["A", "B", "C", "D"],
  "sharedSpeed": [["A", "B"], ["C", "D"]],
  "heartbeatMs": 100,
  "armWithStop": 3,
  "watchdog": false,
  "minSpeedByte": 16,
  "notes": "Hub ignores drive commands until it has received one stop packet after power-on. No watchdog: the motor keeps running without packets, so the controller must send stop on e-stop, disconnect and exit.",
